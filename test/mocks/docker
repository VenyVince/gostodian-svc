#!/bin/sh
printf '%s\n' "$*" >>"${DOCKER_LOG:?}"
if [ "${1-}" = "inspect" ]; then
	name=
	for a in "$@"; do
		name=$a
	done
	if [ ! -f "${DOCKER_STATE:-}" ]; then
		printf '%s\n' "missing state" >&2
		exit 1
	fi
	val=$(awk -v n="$name" '$1 == n { print $2; exit }' "$DOCKER_STATE")
	if [ -z "$val" ]; then
		printf '%s\n' "no such object" >&2
		exit 1
	fi
	printf '%s\n' "$val"
	exit 0
fi
if [ -n "${DOCKER_STDERR-}" ]; then
	printf '%s\n' "$DOCKER_STDERR" >&2
fi
exit "${DOCKER_RC:-0}"
